# Supabase public client configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-anon-key

# Server-side only. Never expose these through VITE_ variables.
STRIPE_SECRET_KEY=replace-on-server
STRIPE_WEBHOOK_SECRET=replace-on-server
PAYPAL_CLIENT_ID=replace-on-server
PAYPAL_CLIENT_SECRET=replace-on-server

# Optional transactional notifications
RESEND_API_KEY=replace-on-server
WHATSAPP_PROVIDER_TOKEN=replace-on-server
